[mysqld]
# ---- memory & storage (week 4 tunes these; the defaults here are deliberately modest) ----
innodb_buffer_pool_size        = 1G
innodb_redo_log_capacity       = 512M
innodb_flush_log_at_trx_commit = 2      # faster bulk load; week 7 discusses what this trades away

# ---- bulk loading ----
local_infile     = 1
secure_file_priv = /data                # server-side LOAD DATA INFILE may read only from here

# ---- observability (week 3: the three sources of truth) ----
performance_schema              = ON
performance_schema_digests_size = 20000
slow_query_log                  = ON
slow_query_log_file             = /var/lib/mysql/slow.log
long_query_time                 = 0.5   # seconds; 10 by default, which hides almost everything
log_slow_extra                  = ON    # rows examined, temp tables, sort passes per statement
log_queries_not_using_indexes   = OFF   # switch ON during the lab and watch the log grow

# ---- connections ----
max_connections = 300
